<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>

<BorderPane xmlns="http://javafx.com/javafx/26"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.module03assignmentgroup3.HelloController">

    <center>
        <TabPane fx:id="tabPane" tabClosingPolicy="UNAVAILABLE">
            <tabs>

                <Tab text="Maze 1">
                    <content>
                        <Pane fx:id="gamePane"
                              focusTraversable="true"
                              prefWidth="609.0"
                              prefHeight="430.0">

                            <children>
                                <ImageView fx:id="mazeView"
                                           fitWidth="609.0"
                                           fitHeight="430.0"
                                           preserveRatio="false"
                                           pickOnBounds="true">
                                    <image>
                                        <Image url="@maze.png"/>
                                    </image>
                                </ImageView>
                            </children>

                        </Pane>
                    </content>
                </Tab>

                <Tab text="Maze 2">
                    <content>
                        <AnchorPane fx:id="maze2Pane"
                                    prefWidth="609.0"
                                    prefHeight="430.0">

                            <children>
                                <ImageView fx:id="maze2View"
                                           fitWidth="609.0"
                                           fitHeight="430.0"
                                           preserveRatio="false"
                                           pickOnBounds="true">
                                    <image>
                                        <Image url="@maze2.png"/>
                                    </image>
                                </ImageView>
                            </children>

                        </AnchorPane>
                    </content>
                </Tab>

            </tabs>

        </TabPane>
    </center>

    <bottom>
        <HBox alignment="CENTER_LEFT" spacing="10">
            <padding>
                <Insets bottom="8"
                        left="8"
                        right="8"
                        top="8"/>
            </padding>

            <Button fx:id="startButton"
                    onAction="#onStartAnimation"
                    text="Start Animation"/>

            <Button fx:id="resetButton"
                    onAction="#onReset"
                    text="Reset"/>

            <Label fx:id="statusLabel"
                   text="Use the arrow keys, or press Start Animation."/>
        </HBox>
    </bottom>

</BorderPane>